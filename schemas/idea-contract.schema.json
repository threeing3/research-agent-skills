{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idea-contract.schema.json",
  "title": "Research Idea Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "idea_id", "revision", "status", "title", "problem", "core_hypothesis", "mechanism", "experiment_entry"],
  "properties": {
    "schema_version": {"enum": ["research-idea/v2", "research-idea/v3", "research-idea/v4"]},
    "contract_profile": {"enum": ["staged-novelty/v1"]},
    "project_id": {"type": "string", "minLength": 1},
    "idea_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["raw", "developing", "screened", "novelty-risk", "discussion-active", "gate-ready", "experiment-ready", "parked", "rejected"]},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validity", "current_pool_status"],
      "properties": {
        "validity": {"enum": ["active", "invalidated", "superseded"]},
        "current_pool_status": {"type": "string", "minLength": 1},
        "invalidated_at": {"type": ["string", "null"]},
        "invalidated_by_event_id": {"type": ["string", "null"]},
        "invalidation_reason": {"type": ["string", "null"]},
        "superseded_by_revision": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "title": {"type": "string", "minLength": 1},
    "development": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "maturity": {"enum": ["seed", "developing", "validation-ready", "formal-experiment-ready"]},
        "idea_type": {"enum": ["mechanism-invention", "baseline-modification", "mechanism-combination", "cross-domain-transfer", "simplification-or-diagnostic"]},
        "implementation_revision": {"type": "integer", "minimum": 1},
        "probe_applicability": {"enum": ["applicable", "not-applicable", "not-identifiable"]}
      }
    },
    "problem": {"type": "string", "minLength": 1},
    "core_hypothesis": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "problem_half_life": {"type": "string"},
    "lineage": {"type": "object"},
    "problem_signature": {"type": "object"},
    "mechanism_signature": {"type": "object"},
    "evaluation_signature": {"type": "object"},
    "contribution": {"type": "object"},
    "source_domain": {"type": "object"},
    "target_domain": {"type": "string"},
    "target_domain_boundary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "task": {"type": "string"},
        "problem_setting": {"type": "string"},
        "key_constraints": {"type": "array", "items": {"type": "string"}},
        "novelty_unit": {"type": "string"}
      }
    },
    "ideation": {"type": "object"},
    "debate": {"type": "object"},
    "closest_work": {"type": "array", "items": {"type": "object"}},
    "novelty": {"type": "object"},
    "novelty_review": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {"enum": ["supported", "occupied", "uncertain"]},
        "coverage_end": {"type": "string"},
        "recall_confidence": {"enum": ["low", "medium", "high"]}
      }
    },
    "evaluation_rubric": {"type": ["object", "null"]},
    "mechanism_identifiability": {"type": "object"},
    "simple_baseline_survival": {"type": "object"},
    "reviewer_patterns": {"type": "object"},
    "reviewer_attack_matrix": {"type": "array", "items": {"type": "object"}},
    "evaluation": {"type": "object"},
    "experiment_entry": {
      "type": "object",
      "required": ["recommended_mode", "cheapest_test"],
      "properties": {
        "recommended_mode": {"enum": ["pilot", "full", "ablation", "robustness", "efficiency", "reproduction", "debug"]},
        "cheapest_test": {"type": "string"}
      },
      "additionalProperties": true
    },
    "process_metrics": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "anti_reskin_gate": {"type": "object"},
    "decision": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"contract_profile": {"const": "staged-novelty/v1"}},
        "required": ["contract_profile"]
      },
      "then": {
        "required": ["development", "target_domain_boundary", "novelty_review", "decision"],
        "properties": {
          "novelty_review": {
            "required": ["status", "coverage_end", "recall_confidence"],
            "properties": {"status": {"const": "supported"}}
          }
        }
      }
    }
  ]
}
