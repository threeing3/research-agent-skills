{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "diagnostic-evidence-handoff.schema.json",
  "title": "Diagnostic Evidence Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "created_at",
    "research_question",
    "experiment_id",
    "plan_revision",
    "verified_stage",
    "observed_failure",
    "tested_explanations",
    "separating_prediction",
    "measurement",
    "intervention_boundary",
    "experiment_plan_sha256",
    "result",
    "scope",
    "limitations",
    "recommended_update",
    "evidence_refs",
    "source_verification_report"
  ],
  "properties": {
    "schema_version": {
      "const": "research-experiment/diagnostic-evidence-handoff-v1"
    },
    "created_at": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "verified_stage": {"const": "verified-diagnostic"},
    "observed_failure": {"type": "string", "minLength": 1},
    "tested_explanations": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "separating_prediction": {"type": "string", "minLength": 1},
    "measurement": {"type": "string", "minLength": 1},
    "intervention_boundary": {"type": "string", "minLength": 1},
    "experiment_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supports", "weakens", "inconclusive"],
      "properties": {
        "supports": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "weakens": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "inconclusive": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "anyOf": [
        {"properties": {"supports": {"minItems": 1}}},
        {"properties": {"weakens": {"minItems": 1}}},
        {"properties": {"inconclusive": {"minItems": 1}}}
      ]
    },
    "scope": {"type": "string", "minLength": 1},
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "recommended_update": {
      "enum": [
        "keep-bottleneck",
        "weaken-bottleneck",
        "narrow-problem",
        "return-to-diagnosis"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source_verification_report": {"type": "string", "minLength": 1}
  }
}
