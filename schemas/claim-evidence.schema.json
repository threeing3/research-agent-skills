{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-evidence.schema.json",
  "title": "Claim Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "claim_id", "claim", "status", "evidence"],
  "properties": {
    "schema_version": {"const": "research-writing/claim-evidence-v1"},
    "project_id": {"type": "string"},
    "claim_id": {"type": "string"},
    "claim": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "supported", "partially-supported", "unsupported", "overstated", "unclear", "blocked"]},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["source", "role"]}},
    "required_evidence": {"type": "array", "items": {"type": "string"}},
    "idea_id": {"type": "string"},
    "idea_revision": {"type": "integer", "minimum": 1},
    "experiment_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "next_action": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "paper_section": {"type": "string"}
  }
}
