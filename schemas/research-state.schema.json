{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "research-state.schema.json",
  "title": "Research State Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "revision", "phase", "paths", "updated_at"],
  "properties": {
    "schema_version": {"const": "research-state/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "phase": {"enum": ["ideation", "experiment", "writing", "submission", "blocked"]},
    "active_idea_id": {"type": ["string", "null"]},
    "active_experiment_id": {"type": ["string", "null"]},
    "paths": {"type": "object", "additionalProperties": {"type": "string"}},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
