{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verification-report.schema.json",
  "title": "Experiment Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verified_at", "experiment_id", "plan_revision", "idea_id", "idea_revision", "idea_contract_sha256", "experiment_plan_sha256", "stage", "passed", "blockers", "checks"],
  "properties": {
    "schema_version": {"const": "research-experiment/experiment-verification-v2"},
    "verified_at": {"type": "string", "minLength": 1},
    "experiment_id": {"type": ["string", "null"]},
    "plan_revision": {"type": ["integer", "null"], "minimum": 1},
    "idea_id": {"type": ["string", "null"]},
    "idea_revision": {"type": ["integer", "null"], "minimum": 1},
    "idea_contract_sha256": {"type": ["string", "null"], "pattern": "^$|^[0-9a-f]{64}$"},
    "experiment_plan_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "stage": {"enum": ["verified-scientific", "paper-ready", "blocked"]},
    "passed": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "evidence": {"type": "string"}
        }
      }
    }
  }
}
