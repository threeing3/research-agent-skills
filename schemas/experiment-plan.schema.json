{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment-plan.schema.json",
  "title": "Experiment Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "experiment_id", "idea_ref", "revision", "mode", "hypothesis", "comparisons", "metrics", "seeds", "stop_conditions"],
  "properties": {
    "schema_version": {"const": "research-experiment/v1"},
    "project_id": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "minLength": 1},
    "idea_ref": {"type": "object", "required": ["idea_id", "idea_revision", "contract_hash"], "properties": {"idea_id": {"type": "string"}, "idea_revision": {"type": "integer", "minimum": 1}, "contract_hash": {"type": "string", "minLength": 1}}},
    "revision": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["pilot", "full", "ablation", "robustness", "efficiency", "reproduction", "debug"]},
    "hypothesis": {"type": "string", "minLength": 1},
    "comparisons": {"type": "array", "items": {"type": "object"}},
    "metrics": {"type": "array", "items": {"type": "object"}},
    "seeds": {"type": "array", "items": {"type": ["integer", "string"]}, "minItems": 1},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "budget": {"type": "object"}
  }
}
